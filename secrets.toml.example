# Copy these into your Streamlit secrets.
# - On Streamlit Cloud: App -> Settings -> Secrets
# - Locally: save as .streamlit/secrets.toml (NEVER commit the real file to GitHub)

YOUTUBE_API_KEY = "your-new-rotated-youtube-key"
APIFY_API_TOKEN = "your-apify-token"
GEMINI_API_KEY = "your-gemini-key"
ANTHROPIC_API_KEY = "your-anthropic-key"
